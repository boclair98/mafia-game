# Copy to .env (gitignored) for `docker compose up`.

# Pre-baked UUID treated as the signed-in user for any X-Coders-User-less
# request — only used in local dev (the platform gate stamps the header
# in prod). Generate your own with `python -c "import uuid; print(uuid.uuid4())"`.
DEV_FAKE_USER=00000000-0000-0000-0000-000000000001

# Backend listens on 0.0.0.0:8000; compose maps that to localhost:8000.
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app

# Per-API-instance capacity and bounded PostgreSQL pool. Tune these with the
# number of API replicas and the managed database connection budget.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE=1800
MAX_ROOMS=5000
MAX_CONNECTIONS=12000
MAX_SPECTATORS_PER_ROOM=12
BROADCAST_TIMEOUT=2
LEADERBOARD_CACHE_TTL=5

# Recover committed game state from PostgreSQL. Production/compose enable this.
# A single active runtime owns progression; this is not horizontal room sharding.
ROOM_PERSISTENCE_ENABLED=true
ROOM_LEASE_SECONDS=15
ROOM_CLOCK_CHECKPOINT_SECONDS=5
ROOM_CHECKPOINT_TTL_SECONDS=86400

# Optional owned TURN relay. Without it, only STUN/direct peer connections are
# available and some corporate/mobile networks cannot connect. Arrays are JSON.
# Keep the real shared secret only in approved secret storage/platform env.
VOICE_STUN_URLS=["stun:stun.l.google.com:19302","stun:stun.cloudflare.com:3478"]
VOICE_TURN_URLS=[]
VOICE_TURN_TTL_SECONDS=900
# VOICE_TURN_SHARED_SECRET=<server-only random secret, at least32 characters>
